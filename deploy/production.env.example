# Production settings for deploy/docker-compose.yml (security audit I-04). Copy, fill in, keep the copy secret:
#   cp deploy/production.env.example deploy/.env.production
# Never commit deploy/.env.production. Every value below is a placeholder or a safe default.

# --- site
BMTL_DOMAIN=<scraptrust.your-company.com>
# TRUSTED_HOSTS is set from BMTL_DOMAIN in docker-compose.yml; the server refuses to start without it.

# --- sign-in (required in production; never disabled_local_dev)
AUTH_MODE=required
SECRET_KEY=<run: python -c "import secrets; print(secrets.token_urlsafe(48))">
COOKIE_SECURE=true
SESSION_TTL_HOURS=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# --- web origins: the web app is served by the API itself, so no cross-origin access is needed
CORS_ORIGINS=[]

# --- AI: offline only (manager decision 2026-11-17); no data leaves the server
COPILOT_PROVIDER=offline
DEBUG=false
EXPOSE_API_DOCS=false

# --- intake
ALLOW_LINK_FETCH=true
MAX_REQUEST_MB=250
USER_STORAGE_QUOTA_MB=500

# --- records and retention (0 = keep everything; set per company policy)
RECORDS_RETENTION_DAYS=0
SESSION_RETENTION_DAYS=365

# --- help page contact shown to users
SUPPORT_CONTACT=<scraptrust-support@your-company.com>

# --- capacity
WEB_CONCURRENCY=4
APP_MEM_LIMIT=12g
