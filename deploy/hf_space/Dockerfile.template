# syntax=docker/dockerfile:1
# ScrapTrust open-testing image for a free Hugging Face Space (Docker SDK, CPU basic). Generated by
# deploy/hf_space/publish.py — edit the template, not the uploaded copy.
# The Space repository is public, so it holds ONLY this file and README.md. The code, the fitted models and the
# reference embeddings stay in a PRIVATE Hugging Face dataset repository, which is downloaded at build time with the
# Space secret HF_TOKEN. The bundle's SHA-256 is pinned below, so only the exact bundle that was published gets built.
# Same hardening as deploy/Dockerfile: pinned base images, hash-locked wheels, models checksum-verified at build,
# offline at run time, code read-only, non-root (Hugging Face runs containers as uid 1000).

# ---------- 0. private code bundle
FROM python:3.13.1-slim-bookworm AS bundle
WORKDIR /bundle
RUN --mount=type=secret,id=HF_TOKEN,mode=0444,required=true python - <<'PY'
import hashlib, tarfile, urllib.request
url = "https://huggingface.co/datasets/__BUNDLE_REPO__/resolve/main/bundle.tar.gz"
token = open("/run/secrets/HF_TOKEN").read().strip()
req = urllib.request.Request(url, headers={"Authorization": "Bearer " + token})
data = urllib.request.urlopen(req, timeout=300).read()
digest = hashlib.sha256(data).hexdigest()
assert digest == "__BUNDLE_SHA256__", "bundle checksum mismatch: " + digest
open("/tmp/b.tgz", "wb").write(data)
with tarfile.open("/tmp/b.tgz") as t:
    t.extractall("/bundle/src", filter="data")
print("bundle verified", digest)
PY

# ---------- 1. web app (static files only end up in the final image)
FROM node:22.11-bookworm-slim AS web
WORKDIR /web
COPY --from=bundle /bundle/src/app/package.json /bundle/src/app/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY --from=bundle /bundle/src/app/index.html /bundle/src/app/vite.config.js /bundle/src/app/tsconfig.json ./
COPY --from=bundle /bundle/src/app/src ./src
RUN npx tsc --noEmit && npx vite build && rm -f dist/assets/*.map

# ---------- 2. python dependencies + pinned, verified models
FROM python:3.13.1-slim-bookworm AS py
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /srv/bmtl/app/backend
COPY --from=bundle /bundle/src/app/backend/requirements-image.lock ./
RUN python -m venv /opt/venv \
 && /opt/venv/bin/pip install --require-hashes --no-deps --only-binary=:all: \
      -r requirements-image.lock --extra-index-url https://download.pytorch.org/whl/cpu \
 && /opt/venv/bin/pip check
COPY --from=bundle /bundle/src/app/backend/app ./app
COPY --from=bundle /bundle/src/app/backend/vendor ./vendor
ENV HF_HOME=/opt/models/hf TORCH_HOME=/opt/models/torch ALLOW_MODEL_DOWNLOADS=true AUTH_MODE=disabled_local_dev
RUN /opt/venv/bin/python -c "from app.core.models_safe import load_dinov2_vits14, load_clip, load_whisper; \
load_dinov2_vits14(); load_clip('openai/clip-vit-base-patch16'); load_whisper('base','cpu','int8'); print('models verified')"

# ---------- 3. runtime
FROM python:3.13.1-slim-bookworm
RUN useradd --uid 1000 --user-group --home-dir /data --no-create-home --shell /usr/sbin/nologin bmtl
COPY --from=py /opt/venv /opt/venv
COPY --from=py /opt/models /opt/models
WORKDIR /srv/bmtl
COPY --from=bundle /bundle/src/src/realdata ./src/realdata
COPY --from=bundle /bundle/src/src/realmodels ./src/realmodels
COPY --from=bundle /bundle/src/models/real ./models/real
COPY --from=bundle /bundle/src/app/backend/app ./app/backend/app
COPY --from=bundle /bundle/src/app/backend/vendor ./app/backend/vendor
COPY --from=bundle /bundle/src/app/backend/scripts ./app/backend/scripts
COPY --from=bundle /bundle/src/app/mineral/src ./app/mineral/src
COPY --from=bundle /bundle/src/app/mineral/models ./app/mineral/models
COPY --from=bundle /bundle/src/app/mineral/data ./app/mineral/data
COPY --from=bundle /bundle/src/app/data/embeddings ./app/data/embeddings
COPY --from=web /web/dist ./app/dist
RUN chown -R root:root /srv/bmtl /opt && chmod -R a-w /srv/bmtl /opt \
 && mkdir -p /data && chown 1000:1000 /data
# Open testing: no login screen, each browser gets its own private guest space; Records are view-only for everyone.
# Storage on a free Space is temporary: chats and Records are wiped whenever the Space restarts.
ENV PATH=/opt/venv/bin:$PATH PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HOME=/data \
    HF_HOME=/opt/models/hf TORCH_HOME=/opt/models/torch HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1 \
    ALLOW_MODEL_DOWNLOADS=false AUTH_MODE=public_demo PUBLIC_RECORDS=true COPILOT_PROVIDER=offline HOST_BINDING=0.0.0.0 \
    LOCAL_STORAGE_PATH=/data/app USERS_FILE=/data/security/users.json RECORDS_FILE=/data/records/records.db \
    COOKIE_SECURE=true TRUST_PROXY_HEADERS=true CORS_ORIGINS=[] DEBUG=false EXPOSE_API_DOCS=false \
    ALLOW_LINK_FETCH=true MAX_REQUEST_MB=95 USER_STORAGE_QUOTA_MB=200 RECORDS_RETENTION_DAYS=0 SESSION_RETENTION_DAYS=60 \
    GUESTS_PER_IP_PER_HOUR=60 GUEST_IP_CHAT_PER_MINUTE=120
USER 1000
WORKDIR /srv/bmtl/app/backend
EXPOSE 7860
# SPACE_HOST is set by Hugging Face (<user>-<space>.hf.space). HF_TOKEN is only for the build: it is removed from
# the app's environment, so the running app never holds it.
CMD ["sh", "-c", "export TRUSTED_HOSTS=\"${TRUSTED_HOSTS:-$SPACE_HOST}\"; exec env -u HF_TOKEN uvicorn app.main:app --host 0.0.0.0 --port 7860 --workers ${WEB_CONCURRENCY:-2} --proxy-headers --forwarded-allow-ips='*' --no-server-header --timeout-keep-alive 5 --limit-concurrency ${MAX_CONCURRENCY:-200}"]
