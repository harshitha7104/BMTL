# ScrapTrust Backend Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# APPLICATION
# ============================================================================
APP_NAME=ScrapTrust Assessment API
APP_VERSION=1.0.0-mvp
DEBUG=true
LOG_LEVEL=INFO

# ============================================================================
# AI PROVIDER CONFIGURATION
# ============================================================================
# Provider selection: "mock" | "openai" | "local"
# Default: "mock" (no API key required, works offline)
AI_PROVIDER=mock

# OpenAI Configuration (OPTIONAL — only if AI_PROVIDER=openai)
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o
# OPENAI_TIMEOUT=60
# OPENAI_MAX_RETRIES=3

# ============================================================================
# COPILOT (scrap / waste / mineral assistant) — /api/v1/copilot
# ============================================================================
# "auto" uses the first configured provider: claude -> openai -> gemini -> openai_compatible,
# and falls back to "offline" (engines only, no LLM) when no key is set.
COPILOT_PROVIDER=auto
COPILOT_MAX_TOOL_ROUNDS=8

# Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium            # low | medium | high | xhigh | max

# OpenAI (uses OPENAI_API_KEY / OPENAI_MODEL above)

# Google Gemini
# GEMINI_API_KEY=your-gemini-key
# GEMINI_MODEL=gemini-2.5-pro

# Any OpenAI-compatible endpoint (Ollama, LM Studio, vLLM, Groq, OpenRouter, ...)
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPATIBLE_MODEL=llama3.2-vision
# OPENAI_COMPATIBLE_API_KEY=

# Data locations (defaults resolve from the repository root)
# EMBEDDINGS_DIR=../data/embeddings
# MINERAL_DIR=../mineral
# WASTE_IMAGE_ROOTS=../data/raw/wastes,../wastes

# Local Vision Model (OPTIONAL — only if AI_PROVIDER=local)
# LOCAL_MODEL_PATH=./models/scrap-vision-v1
# LOCAL_MODEL_DEVICE=cpu  # or "cuda" if GPU available

# ============================================================================
# UPLOAD LIMITS
# ============================================================================
MAX_UPLOAD_SIZE_MB=10
MAX_IMAGES_PER_ASSESSMENT=5
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# ============================================================================
# STORAGE
# ============================================================================
# Storage type: "local" | "postgres" | "s3"
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./data
LOCAL_DB_PATH=./data/assessments.db

# PostgreSQL (production only)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/scraptrust

# S3 (production only)
# S3_BUCKET=scrap-assessments
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key

# ============================================================================
# SECURITY
# ============================================================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]
RATE_LIMIT_PER_MINUTE=30
SECRET_KEY=change-this-to-a-random-secret-in-production

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_HUMAN_REVIEW=true
ENABLE_XRF_RECOMMENDATION=true
