# ScrapTrust Backend Environment Variables
# Copy this file to .env and fill in your values

# OpenAI Configuration
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT=60
OPENAI_MAX_RETRIES=3

# Upload Limits
MAX_UPLOAD_SIZE_MB=10
MAX_IMAGES_PER_ASSESSMENT=5

# Storage Configuration
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./data

# Database (production only)
# DATABASE_URL=postgresql://user:password@localhost:5432/scraptrust

# S3 (production only)
# S3_BUCKET=scrap-assessments
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key

# Security
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
RATE_LIMIT_PER_MINUTE=30
SECRET_KEY=change-this-to-a-random-secret-in-production

# Logging
LOG_LEVEL=INFO
